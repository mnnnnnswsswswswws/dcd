// Video-Challenge-Plattform — Prisma-Schema (fokussierter Phase-0-Ausschnitt).
//
// Dieser Ausschnitt enthält die Modelle und Enums, die für die aktive Aufgabe
// `joinChallenge` (transaktionssichere Slot-Reservierung) benötigt werden, sowie
// die direkt angrenzenden Entitäten (User, Submission, WinnerDecision), damit die
// nicht verhandelbaren Constraints (Unique-Slot pro Nutzer, eine Einsendung pro
// Nutzer, genau eine Winner-Decision pro Challenge) real durchgesetzt werden.
//
// Geldbeträge ausschließlich als Integer in Cent. Timestamps in UTC. IDs als UUID.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ChallengeStatus {
  DRAFT
  PENDING_FUNDING
  OPEN
  FULL
  SUBMISSIONS_CLOSED
  IN_REVIEW
  SELECTION
  WINNER_LOCKED
  PAID_OUT
  CANCELLED
  EXPIRED
}

enum SlotStatus {
  RESERVED
  CAPTURING
  UPLOADING
  SUBMITTED
  EXPIRED
  CANCELLED
}

enum SubmissionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  WINNER
  LOSER
}

enum SelectionMode {
  CREATOR_DECIDES
  COMMUNITY_VOTE
}

enum FundingStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum PayoutStatus {
  PENDING
  HELD
  PAID
  FAILED
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
}

enum EvidenceStatus {
  PENDING
  UPLOADED
  ATTACHED
  EXPIRED
}

/// Like auf eine Challenge (ein Like pro Nutzer/Challenge).
model ChallengeLike {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@map("challenge_likes")
}

/// Merkzettel-Eintrag (ein Bookmark pro Nutzer/Challenge).
model ChallengeBookmark {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([challengeId, userId])
  @@index([userId])
  @@map("challenge_bookmarks")
}

/// Kommentar zu einer Challenge.
model Comment {
  id          String   @id @default(uuid()) @db.Uuid
  challengeId String   @map("challenge_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  body        String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([challengeId, createdAt])
  @@map("comments")
}

/// In-App-Benachrichtigung an einen Nutzer (aus Domänenereignissen abgeleitet).
model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  type        String
  challengeId String?   @map("challenge_id") @db.Uuid
  title       String
  body        String
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@map("notifications")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  isAdult     Boolean  @default(false) @map("is_adult")
  username    String?  @unique
  displayName String?  @map("display_name")
  bio         String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  createdChallenges Challenge[]  @relation("ChallengeCreator")
  slots             Slot[]
  submissions       Submission[]
  votes             Vote[]
  reports           Report[]
  evidence          EvidenceAsset[]
  notifications     Notification[]
  likes             ChallengeLike[]
  bookmarks         ChallengeBookmark[]
  comments          Comment[]

  @@map("users")
}

model Challenge {
  id                 String          @id @default(uuid()) @db.Uuid
  creatorId          String          @map("creator_id") @db.Uuid
  title              String          @default("")
  description        String?
  category           String?
  status             ChallengeStatus @default(DRAFT)
  selectionMode      SelectionMode   @map("selection_mode")
  prizeAmountCents   Int             @map("prize_amount_cents")
  maxSlots           Int             @default(10) @map("max_slots")
  submissionDeadline DateTime?       @map("submission_deadline") @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  creator     User                @relation("ChallengeCreator", fields: [creatorId], references: [id])
  slots       Slot[]
  submissions Submission[]
  votes       Vote[]
  criteria    ChallengeCriterion[]
  evidence    EvidenceAsset[]
  likes       ChallengeLike[]
  bookmarks   ChallengeBookmark[]
  comments    Comment[]
  decision    WinnerDecision?
  funding     ChallengeFunding?
  payout      Payout?
  ledger      LedgerEntry[]

  @@index([status])
  @@map("challenges")
}

/// Prüfbare Erfolgskriterien einer Challenge (Wizard-Schritt 2).
model ChallengeCriterion {
  id           String  @id @default(uuid()) @db.Uuid
  challengeId  String  @map("challenge_id") @db.Uuid
  title        String
  description  String?
  mandatory    Boolean @default(true)
  evidenceType String? @map("evidence_type")
  sortOrder    Int     @map("sort_order")

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@index([challengeId])
  @@map("challenge_criteria")
}

model ChallengeFunding {
  id             String        @id @default(uuid()) @db.Uuid
  challengeId    String        @unique @map("challenge_id") @db.Uuid
  provider       String
  providerRef    String        @unique @map("provider_ref")
  idempotencyKey String        @unique @map("idempotency_key")
  amountCents    Int           @map("amount_cents")
  currency       String        @default("eur")
  status         FundingStatus @default(PENDING)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  confirmedAt    DateTime?     @map("confirmed_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@index([status])
  @@map("challenge_fundings")
}

/// Nutzer-Meldungen zu Inhalten/Konten (Spec 14.5). Priorität wird aus dem Grund
/// abgeleitet; Bearbeitung erfolgt in der Admin-/Moderationsqueue.
model Report {
  id          String         @id @default(uuid()) @db.Uuid
  reporterId  String         @map("reporter_id") @db.Uuid
  targetType  String         @map("target_type")
  targetId    String         @map("target_id") @db.Uuid
  reason      String
  description String?
  status      ReportStatus   @default(OPEN)
  priority    ReportPriority @default(MEDIUM)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt  DateTime?      @map("resolved_at") @db.Timestamptz(6)

  reporter User @relation(fields: [reporterId], references: [id])

  @@index([status, priority])
  @@index([targetType, targetId])
  @@map("reports")
}

/// Revisionssicheres Audit-Log kritischer Zustandsänderungen (Geld, Gewinner, Status).
/// Append-only: Updates/Deletes werden per DB-Trigger hart abgelehnt (siehe
/// prisma/sql/immutability.sql). Einträge werden innerhalb der jeweiligen Transaktion
/// geschrieben, sind also atomar mit der Zustandsänderung.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorType  String   @map("actor_type") // USER | ADMIN | SYSTEM
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id") @db.Uuid
  beforeJson Json?    @map("before_json")
  afterJson  Json?    @map("after_json")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([targetType, targetId])
  @@map("audit_logs")
}

/// Unveränderliche, doppelte Buchführung. Updates/Deletes werden per DB-Trigger
/// (prisma/sql/immutability.sql) hart abgelehnt; die App schreibt ausschließlich neu.
model LedgerEntry {
  id          String          @id @default(uuid()) @db.Uuid
  challengeId String          @map("challenge_id") @db.Uuid
  account     String
  direction   LedgerDirection
  amountCents Int             @map("amount_cents")
  entryType   String          @map("entry_type")
  referenceId String?         @map("reference_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@index([challengeId])
  @@map("ledger_entries")
}

model Slot {
  id            String     @id @default(uuid()) @db.Uuid
  challengeId   String     @map("challenge_id") @db.Uuid
  participantId String     @map("participant_id") @db.Uuid
  status        SlotStatus @default(RESERVED)
  expiresAt     DateTime?  @map("expires_at") @db.Timestamptz(6)
  reservedAt    DateTime   @default(now()) @map("reserved_at") @db.Timestamptz(6)
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  challenge   Challenge @relation(fields: [challengeId], references: [id])
  participant User      @relation(fields: [participantId], references: [id])

  // Ein Nutzer belegt höchstens einen Slot pro Challenge.
  @@unique([challengeId, participantId])
  @@index([challengeId, status])
  @@map("slots")
}

model Submission {
  id            String           @id @default(uuid()) @db.Uuid
  challengeId   String           @map("challenge_id") @db.Uuid
  participantId String           @map("participant_id") @db.Uuid
  status        SubmissionStatus @default(DRAFT)
  finalizedAt   DateTime?        @map("finalized_at") @db.Timestamptz(6)
  evidenceRef   String?          @map("evidence_ref") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  challenge   Challenge @relation(fields: [challengeId], references: [id])
  participant User      @relation(fields: [participantId], references: [id])
  votes       Vote[]

  // Eine gültige Einsendung pro Nutzer pro Challenge.
  @@unique([challengeId, participantId])
  @@index([challengeId, status])
  @@map("submissions")
}

/// In-App aufgenommener Beweis (Spec: In-App-Beweisaufnahme ohne Galerieimport/Schnitt).
/// Ein Datensatz entsteht ausschließlich über die Capture-Intent-API — der Ref ist damit
/// der Nachweis der In-App-Herkunft. Beim Einreichen wird er an die Einsendung gebunden.
model EvidenceAsset {
  id            String         @id @default(uuid()) @db.Uuid
  challengeId   String         @map("challenge_id") @db.Uuid
  participantId String         @map("participant_id") @db.Uuid
  storageKey    String         @map("storage_key")
  status        EvidenceStatus @default(PENDING)
  capturedInApp Boolean        @default(true) @map("captured_in_app")
  durationMs    Int?           @map("duration_ms")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  challenge   Challenge @relation(fields: [challengeId], references: [id])
  participant User      @relation(fields: [participantId], references: [id])

  @@index([challengeId, participantId])
  @@map("evidence_assets")
}

model Vote {
  id           String   @id @default(uuid()) @db.Uuid
  challengeId  String   @map("challenge_id") @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  voterId      String   @map("voter_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge  Challenge  @relation(fields: [challengeId], references: [id])
  submission Submission @relation(fields: [submissionId], references: [id])
  voter      User       @relation(fields: [voterId], references: [id])

  // Eine Stimme pro Nutzer pro Challenge.
  @@unique([challengeId, voterId])
  @@index([submissionId])
  @@map("votes")
}

model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  challengeId    String       @unique @map("challenge_id") @db.Uuid
  submissionId   String       @map("submission_id") @db.Uuid
  amountCents    Int          @map("amount_cents")
  status         PayoutStatus @default(PENDING)
  idempotencyKey String       @unique @map("idempotency_key")
  providerRef    String?      @map("provider_ref")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  paidAt         DateTime?    @map("paid_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@map("payouts")
}

model WinnerDecision {
  id                 String   @id @default(uuid()) @db.Uuid
  challengeId        String   @unique @map("challenge_id") @db.Uuid
  winnerSubmissionId String?  @map("winner_submission_id") @db.Uuid
  decisionSource     String   @map("decision_source")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  challenge Challenge @relation(fields: [challengeId], references: [id])

  @@map("winner_decisions")
}
