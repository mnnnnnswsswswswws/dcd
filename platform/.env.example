# Datenbank
DATABASE_URL="postgresql://vcp:vcp@localhost:5432/vcp?schema=public"

# Laufzeit
NODE_ENV="development"

# Slot-Reservierung: Time-to-live einer RESERVED-Reservierung in Millisekunden (Default 10 Minuten)
SLOT_RESERVATION_TTL_MS="600000"

# Gemeinsames Secret zur Verifikation eingehender Zahlungs-Webhooks (Mock-Provider)
WEBHOOK_SECRET="dev-webhook-secret"

# Auth-Provider: "mock" (Token = User-ID) oder "firebase" (braucht Credentials via
# GOOGLE_APPLICATION_CREDENTIALS und die Projekt-ID).
AUTH_PROVIDER="mock"
# FIREBASE_PROJECT_ID=""

# Zahlungs-Provider: "mock" oder "stripe" (Testmodus mit Test-Keys).
PAYMENTS_PROVIDER="mock"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Feature-Flags — alle default false, Änderung nur nach ausdrücklicher Freigabe.
REAL_MONEY_ENABLED="false"
STRIPE_LIVE_MODE="false"
PAYOUTS_ENABLED="false"
PUBLIC_FEED_ENABLED="false"
LONG_CAPTURE_ENABLED="false"
PHYSICAL_FULFILLMENT_ENABLED="false"
