# Datenbank
DATABASE_URL="postgresql://vcp:vcp@localhost:5432/vcp?schema=public"

# Laufzeit
NODE_ENV="development"

# Slot-Reservierung: Time-to-live einer RESERVED-Reservierung in Millisekunden (Default 10 Minuten)
SLOT_RESERVATION_TTL_MS="600000"

# Gemeinsames Secret zur Verifikation eingehender Zahlungs-Webhooks (Mock-Provider)
# In Produktion (NODE_ENV=production) MUSS dies ein echter, nicht-Default-Wert sein.
WEBHOOK_SECRET="dev-webhook-secret"

# Erlaubte CORS-Origins (kommagetrennt), z. B. Admin-/Web-Frontend. Leer = keine
# Cross-Origin-Freigabe. "*" erlaubt alle (nur für Entwicklung).
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# Frontend (Next.js, apps/web + apps/admin): Basis-URL der API. Wird zur Build-Zeit
# eingebettet (NEXT_PUBLIC_*). Für den Launch auf die öffentliche API-URL setzen, z. B.
# https://api.deine-domain.de — sonst greift der lokale Fallback http://localhost:8080.
NEXT_PUBLIC_API_BASE="http://localhost:8080"

# Rate-Limit pro IP: Zeitfenster (ms) und maximale Requests im Fenster.
RATE_LIMIT_TTL_MS="60000"
RATE_LIMIT_MAX="120"

# Auth-Provider: "mock" (Token = User-ID) oder "firebase" (braucht Credentials via
# GOOGLE_APPLICATION_CREDENTIALS und die Projekt-ID).
AUTH_PROVIDER="mock"
# FIREBASE_PROJECT_ID=""

# Zahlungs-Provider: "mock" oder "stripe" (Testmodus mit Test-Keys).
PAYMENTS_PROVIDER="mock"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Evidence-Storage der In-App-Aufnahme: "mock" (kein Netzwerk) oder "s3"
# (S3-kompatibel: AWS S3, Cloudflare R2, MinIO, Backblaze B2 …). Bei "s3" lädt die App
# die Aufnahme per presignter PUT-URL direkt in den Bucket. STORAGE_PROVIDER=s3 erfordert
# Endpoint, Region, Bucket und Credentials.
STORAGE_PROVIDER="mock"
# STORAGE_S3_ENDPOINT="https://s3.eu-central-1.amazonaws.com"
# STORAGE_S3_REGION="eu-central-1"
# STORAGE_S3_BUCKET="vcp-evidence"
# STORAGE_S3_ACCESS_KEY_ID="AKIA..."
# STORAGE_S3_SECRET_ACCESS_KEY="..."
# STORAGE_S3_FORCE_PATH_STYLE="false"   # true für MinIO / manche R2-Setups
# STORAGE_S3_UPLOAD_TTL_S="900"         # Gültigkeit der Upload-URL in Sekunden

# App-Check: verlangt bei aktivem Flag einen gültigen `x-firebase-appcheck`-Header für
# App-Requests (Webhooks/Health/Config ausgenommen). Verifier folgt AUTH_PROVIDER
# (mock = jeder nicht-leere Token; firebase = echte Verifikation). Default aus.
APP_CHECK_ENABLED="false"

# Feature-Flags — alle default false, Änderung nur nach ausdrücklicher Freigabe.
REAL_MONEY_ENABLED="false"
STRIPE_LIVE_MODE="false"
PAYOUTS_ENABLED="false"
PUBLIC_FEED_ENABLED="false"
LONG_CAPTURE_ENABLED="false"
PHYSICAL_FULFILLMENT_ENABLED="false"
