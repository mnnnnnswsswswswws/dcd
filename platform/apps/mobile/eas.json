{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-YOUR-PUBLIC-API-URL"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE": "https://REPLACE-WITH-YOUR-PUBLIC-API-URL"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE-WITH-APP-STORE-CONNECT-APP-ID",
        "appleTeamId": "REPLACE-WITH-APPLE-TEAM-ID"
      }
    }
  }
}
