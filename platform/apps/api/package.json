{
  "name": "@vcp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@nestjs/common": "10",
    "@nestjs/core": "10",
    "@nestjs/platform-express": "10",
    "@nestjs/throttler": "6",
    "@prisma/client": "5.22.0",
    "@vcp/cache": "workspace:*",
    "@vcp/capacity": "workspace:^",
    "@vcp/config": "workspace:*",
    "@vcp/contracts": "workspace:*",
    "@vcp/domain": "workspace:*",
    "@vcp/outbox": "workspace:*",
    "@vcp/payments": "workspace:^",
    "firebase-admin": "12",
    "helmet": "8",
    "ioredis": "5.11.1",
    "reflect-metadata": "0.2",
    "rxjs": "7",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "10",
    "@swc/core": "1",
    "@types/express": "4",
    "@types/supertest": "6",
    "supertest": "7",
    "tsx": "4",
    "unplugin-swc": "1"
  }
}
